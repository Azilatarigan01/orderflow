# ==============================================================================
# OrderFlow Enterprise - Production Environment Configuration Template
# ==============================================================================
APP_NAME="OrderFlow Enterprise"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://app.orderflow.demo
FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# High-Security Password Hashing
BCRYPT_ROUNDS=12

# Production Logging (Strictly warning/error or daily rotation, no sensitive info)
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Isolated Production Database (Strictly Separate from Local/Staging)
DB_CONNECTION=mysql
DB_HOST=production-db-instance.internal
DB_PORT=3306
DB_DATABASE=orderflow_production
DB_USERNAME=orderflow_prod_user
DB_PASSWORD=YOUR_HIGH_ENTROPY_PRODUCTION_PASSWORD_HERE

# Production Session Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Caching & Queue
CACHE_STORE=database
CACHE_PREFIX=orderflow_prod_
QUEUE_CONNECTION=database

# Filesystem & Storage
FILESYSTEM_DISK=public

# Production Mail Delivery (SMTP / SES)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@orderflow.demo
MAIL_PASSWORD=YOUR_SMTP_KEY_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@orderflow.demo"
MAIL_FROM_NAME="OrderFlow Enterprise Procurement"

# Optional Cloud Storage (e.g. AWS S3 / MinIO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=orderflow-procurement-docs
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend Configuration
VITE_APP_NAME="${APP_NAME}"
