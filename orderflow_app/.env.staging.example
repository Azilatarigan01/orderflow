# ==============================================================================
# OrderFlow Enterprise - Staging Environment Configuration Template
# ==============================================================================
APP_NAME="OrderFlow Enterprise [STAGING]"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://staging.orderflow.demo
FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Security & Password Hashing
BCRYPT_ROUNDS=12

# Logging Configuration (Daily rotated logs for staging QA)
LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Database Configuration (Dedicated Staging Database)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orderflow_staging
DB_USERNAME=orderflow_staging_user
DB_PASSWORD=YOUR_STRONG_STAGING_PASSWORD_HERE

# Session & Cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue
CACHE_STORE=database
CACHE_PREFIX=orderflow_staging_
QUEUE_CONNECTION=database

# Filesystem & Storage (Public / S3)
FILESYSTEM_DISK=public

# Mail Driver (Catch-all or Log in Staging)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply-staging@orderflow.demo"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Asset Bundler
VITE_APP_NAME="${APP_NAME}"
