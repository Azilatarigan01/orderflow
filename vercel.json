{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/orderflow_app/public/build/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/orderflow_app/public/images/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/orderflow_app/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/orderflow_app/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
